# Compiler optimization - chosen by measurement, not inherited from v4 (#202)
# Measured on CI's own toolchain (ESP-IDF v5.4.4-1000-g8543b57cf15, GCC 14.2.0):
#   DEBUG  bin 1761952 B  DIRAM 222931  IRAM 16383
#   SIZE   bin 1613984 B  DIRAM 212259  IRAM 16383   <- smallest image, lowest DIRAM
#   PERF   bin 1765520 B  DIRAM 219007  IRAM 16383
# The accepted set is owned by tools/check_release_config.py (CHOICE_INVARIANT's
# "allowed"/"rejected"): either SIZE or PERF passes, DEBUG/NONE are rejected. Change
# it there, not in cmake/rk_release_config.cmake, which only runs that checker and
# names no optimization symbol. This line carries the measured choice; admitting a
# mode outside the SIZE/PERF pair is a reviewed multi-place amendment, not a defaults
# edit. Full table, decision rule and that edit surface:
# docs/meta/decisions/2026-07-29_DECISION_EFFECTIVE_RELEASE_CONFIG.md
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM Configuration (required for artwork RGB565 buffers)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# WiFi memory optimization (needed when BT is also enabled)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# Network identity - replace "espressif" with project name for NetBIOS/LLMNR
CONFIG_LWIP_LOCAL_HOSTNAME="roon-knob"

# Brownout detection - lower threshold for battery operation
# Level 4 (2.50V) allows WiFi current spikes without false triggers
# Level 7 (2.80V default) causes boot failures on battery due to WiFi inrush
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP_BROWNOUT_DET_LVL=4
CONFIG_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP32S3_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_BROWNOUT_DET_LVL=4
CONFIG_ESP32S3_BROWNOUT_DET_LVL=4

# LVGL JPEG Decoder - Disabled (using ESP_NEW_JPEG instead)
# CONFIG_LV_USE_TJPGD is not set

# LVGL Examples - Disabled (unused, bloats build)
# CONFIG_LV_BUILD_EXAMPLES is not set

# LVGL Matrix Rotation - Required for software display rotation
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_MATRIX=y
CONFIG_LV_DRAW_TRANSFORM_USE_MATRIX=y

# LVGL Fonts - built-in Montserrat for fallback only
# Main fonts are pre-rendered bitmap fonts (Charis SIL + Material Symbols)
# generated at build time via scripts/generate_fonts.sh
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Arabic/Persian text shaping (contextual glyph forms for bitmap fonts)
CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y

# Display Sleep Settings
CONFIG_RK_DISPLAY_DIM_TIMEOUT_SEC=30
CONFIG_RK_DISPLAY_SLEEP_TIMEOUT_SEC=60
CONFIG_RK_BACKLIGHT_NORMAL=100
CONFIG_RK_BACKLIGHT_DIM=25

# HTTP Server - larger header buffer for modern browsers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# Power Management - enables CPU frequency scaling (optional, disabled by default in firmware)
# When enabled in bridge config, allows CPU to scale down when idle to save power
# Trade-off: adds 0.2-40us interrupt latency
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Bluetooth disabled on S3 - Bluetooth functionality moved to ESP32 chip
# See docs/DUAL_CHIP_ARCHITECTURE.md for the dual-chip Bluetooth architecture
CONFIG_BT_ENABLED=n
